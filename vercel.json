{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "crons": [
    {
      "path": "/api/ai/schedule?action=evaluate-schedule",
      "schedule": "0 4 * * *"
    }
  ]
}
