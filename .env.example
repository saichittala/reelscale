# ==========================================
# ReelScale Production Environment Variables
# ==========================================

# 1. Neon Serverless Postgres Database (Production / Staging)
DATABASE_URL=postgresql://user:password@ep-host-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Redis Cache Configuration
# Option A: Cloud Managed Redis (Upstash / Redis Cloud / AWS ElastiCache / Aiven)
# Use rediss:// protocol for automatic TLS encryption in production
REDIS_URL=rediss://default:your-redis-password@your-redis-host.upstash.io:6379

# Option B: Discrete Parameters (Local development or custom network)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. Sanity CMS Content Lake
NEXT_PUBLIC_SANITY_PROJECT_ID=2gdjnoi2
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
SANITY_API_WRITE_TOKEN=your-sanity-write-token
SANITY_REVALIDATE_SECRET=your-revalidate-secret

# 4. Legacy Google Apps Script Webhooks (Optional Fallback)
GOOGLE_SCRIPT_CLIENTS_URL=https://script.google.com/macros/s/YOUR_CLIENTS_SCRIPT_ID/exec
GOOGLE_SCRIPT_USERS_URL=https://script.google.com/macros/s/YOUR_USERS_SCRIPT_ID/exec
GOOGLE_SCRIPT_SALES_URL=https://script.google.com/macros/s/YOUR_SALES_SCRIPT_ID/exec
